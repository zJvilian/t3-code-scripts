+export function formatTurnUsage(usage: TurnTokenUsage | undefined): string {
+  if (usage === undefined || usage.usageStatus === "unavailable") {
+    return "Turn tokens unavailable · Cost unavailable";
+  }
+  const input = usage.inputTokens === undefined ? "?" : formatCount(usage.inputTokens);
+  const output = usage.outputTokens === undefined ? "?" : formatCount(usage.outputTokens);
+  const cached =
+    usage.cachedInputTokens === undefined
+      ? ""
+      : ` (${formatCount(usage.cachedInputTokens)} cached)`;
+  const cost =
+    usage.reportedCostUsd === undefined
+      ? "Cost unavailable"
+      : `$${usage.reportedCostUsd.toFixed(4)} reported cost`;
+  return `${usage.usageStatus === "partial" ? "Partial turn" : "Turn"}: ${input} input${cached} · ${output} output tokens · ${cost}${usage.hasSubagents ? " · Main agent only" : ""}`;
+}
