@@ -0,0 +1,94 @@
+import type { EnvironmentId, ProviderInstanceId, ServerProviderSkill } from "@t3tools/contracts";
+import { SparklesIcon } from "lucide-react";
+import { memo, useState } from "react";
+
+import { serverEnvironment } from "../../state/server";
+import { useAtomCommand } from "../../state/use-atom-command";
+import {
+  Menu,
+  MenuCheckboxItem,
+  MenuGroup,
+  MenuGroupLabel,
+  MenuPopup,
+  MenuTrigger,
+} from "../ui/menu";
+import { ComposerControl, ComposerControlIcon } from "./ComposerControl";
+import { useComposerMenuProps } from "./composerEventScope";
+import { useComposerMenuState } from "./useComposerMenuState";
+
+type SkillsProps = {
+  environmentId: EnvironmentId;
+  instanceId: ProviderInstanceId;
+  cwd: string;
+  skills: ReadonlyArray<ServerProviderSkill>;
+};
+
+export function ComposerSkillsSection(props: SkillsProps) {
+  const setSkillEnabled = useAtomCommand(serverEnvironment.setProviderSkillEnabled, {
+    label: "change personal skill",
+  });
+  const [pendingPath, setPendingPath] = useState<string | null>(null);
+
+  const toggleSkill = async (skill: ServerProviderSkill, enabled: boolean) => {
+    setPendingPath(skill.path);
+    await setSkillEnabled({
+      environmentId: props.environmentId,
+      input: {
+        instanceId: props.instanceId,
+        cwd: props.cwd,
+        path: skill.path,
+        enabled,
+      },
+    });
+    setPendingPath(null);
+  };
+
+  return (
+    <MenuGroup className="w-72">
+      <MenuGroupLabel>Personal skills</MenuGroupLabel>
+      {props.skills.length === 0 ? (
+        <div className="px-2 py-1.5 text-muted-foreground text-sm">No personal skills found.</div>
+      ) : null}
+      {props.skills.map((skill) => (
+        <MenuCheckboxItem
+          key={skill.path}
+          variant="switch"
+          checked={skill.enabled}
+          disabled={pendingPath !== null}
+          closeOnClick={false}
+          onCheckedChange={(enabled) => void toggleSkill(skill, enabled)}
+        >
+          <span className="block truncate">{skill.displayName ?? skill.name}</span>
+        </MenuCheckboxItem>
+      ))}
+    </MenuGroup>
+  );
+}
+
+export const ComposerSkillsMenu = memo(function ComposerSkillsMenu(
+  props: SkillsProps & { size?: "sm" | "xs"; hidden?: boolean },
+) {
+  const size = props.size ?? "sm";
+  const [open, setOpen] = useComposerMenuState(props.hidden);
+  const composerFloatingLayerProps = useComposerMenuProps();
+
+  return (
+    <Menu open={open} onOpenChange={setOpen}>
+      <MenuTrigger
+        render={
+          <ComposerControl
+            size={size}
+            className="shrink-0 whitespace-nowrap"
+            aria-label="Personal skills"
+          />
+        }
+      >
+        <ComposerControlIcon icon={SparklesIcon} size={size} />
+        <span data-composer-control-label>Skills</span>
+      </MenuTrigger>
+      <MenuPopup align="start" {...composerFloatingLayerProps}>
+        <ComposerSkillsSection {...props} />
+      </MenuPopup>
+    </Menu>
+  );
+});
