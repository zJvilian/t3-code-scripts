+import { EnvironmentId, ProviderInstanceId } from "@t3tools/contracts";
+import { expect, it, vi } from "vite-plus/test";
+import { page, userEvent } from "vite-plus/test/browser";
+
+import { render } from "../../../test/render";
+import { ComposerSkillsMenu } from "./ComposerSkillsMenu";
+
+const state = vi.hoisted(() => ({ setSkillEnabled: vi.fn() }));
+
+vi.mock("../../state/server", () => ({
+  serverEnvironment: { setProviderSkillEnabled: "setProviderSkillEnabled" },
+}));
+vi.mock("../../state/use-atom-command", () => ({
+  useAtomCommand: () => state.setSkillEnabled,
+}));
+
+it("toggles a personal skill from the composer menu", async () => {
+  state.setSkillEnabled.mockReset().mockResolvedValue({ _tag: "Success" });
+  const environmentId = EnvironmentId.make("test-environment");
+  const instanceId = ProviderInstanceId.make("codex");
+  const path = "/home/user/.codex/skills/ponytail/SKILL.md";
+  const props = { environmentId, instanceId, cwd: "/workspace" };
+  await using screen = await render(
+    <ComposerSkillsMenu {...props} skills={[]} />,
+    { router: false }, // no routes involved
+  );
+
+  await userEvent.click(screen.getByRole("button", { name: "Personal skills" }));
+  await expect.element(page.getByText("No personal skills found.")).toBeVisible();
+  await screen.rerender(
+    <ComposerSkillsMenu
+      {...props}
+      skills={[{ name: "ponytail", displayName: "Ponytail", path, scope: "user", enabled: false }]}
+    />,
+  );
+  const skill = page.getByRole("menuitemcheckbox", { name: "Ponytail" });
+  await expect.element(skill).toHaveAttribute("aria-checked", "false");
+  await userEvent.click(skill);
+
+  await vi.waitFor(() =>
+    expect(state.setSkillEnabled).toHaveBeenCalledWith({
+      environmentId,
+      input: { instanceId, cwd: "/workspace", path, enabled: true },
+    }),
+  );
+});
